# ===== 模式切换配置 =====
# 云端定时模式开关（GitHub Actions 中使用，设为 false 关闭云端自动运行）
ENABLE_CLOUD_MONITOR=true

# ===== 自选股配置 =====
STOCK_LIST=600519,000001,300750,002594,601318

# ===== LLM 配置（OpenAI 兼容接口，支持 DeepSeek/通义千问/Anspire 等）=====
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 飞书推送配置 =====
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_hook_id
FEISHU_SECRET=

# ===== 可选：Tushare 增强数据 =====
TUSHARE_TOKEN=

# ===== 选股配置 =====
# 低价股价格上限（元）
LOW_PRICE_THRESHOLD=10
# 选股数量上限
SCREENER_MAX_RESULTS=50
# 选股范围：全A / 沪深300 / 中证500 / 创业板
SCREENER_UNIVERSE=all

# ===== 分析配置 =====
# 技术指标历史天数
TECHNICAL_LOOKBACK_DAYS=120
# 是否启用 LLM 深度分析
ENABLE_LLM=true
